# Конфигурация Laptop Hosting Panel

# Секретный ключ для JWT и сессий (ОБЯЗАТЕЛЬНО ИЗМЕНИТЕ В ПРОДАКШЕНЕ!)
SECRET_KEY=your-secret-key-change-this-in-production

# База данных
DATABASE_PATH=./data/panel.db

# Сервер
HOST=0.0.0.0
PORT=5000
DEBUG=True

# Директории
SERVERS_DIR=./servers
LOGS_DIR=./logs
DATA_DIR=./data

# Настройки серверов
MAX_SERVERS=10
DEFAULT_SERVER_TIMEOUT=30

# WebSocket
SOCKETIO_ASYNC_MODE=eventlet
